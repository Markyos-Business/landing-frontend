# ─────────────────────────────────────────────────────────────────────────────
# markyos.com — marketing site
# Copy to .env.local and fill. Nothing here is a secret until Payload lands.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin of this site. Used for sitemap.xml, robots.txt, hreflang
# and Open Graph absolute URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Platform origin (no trailing slash). Website auth buttons link directly to
# /login or /signup, preserving language and account type. Use the staging
# platform URL in Preview deployments; rebuild after changing this value.
NEXT_PUBLIC_APP_URL=https://app.markyos.com

# Launch phase. Drives which CTA set renders site-wide and whether the
# announcement bar shows the beta copy or the "we're open" copy.
#   beta   → pre-launch: waitlist CTAs, "Arriving February 2027" on MVP features
#   public → post-launch (from Mon 15 Feb 2027): free-plan CTAs
# See lib/launch.ts and copy doc §3 + §6.3.
NEXT_PUBLIC_LAUNCH_PHASE=public

# ── Phase 3: Payload CMS ─────────────────────────────────────────────────────
# Same Neon/Supabase Postgres instance as the platform app, separate schema.
# DATABASE_URI=
# PAYLOAD_SECRET=

# Cloudflare R2 — same bucket as brand assets, separate key prefix.
# R2_BUCKET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# ── Payload CMS ──────────────────────────────────────────────────────────────
# Signs admin sessions. Generate with: openssl rand -base64 32
# Required in every environment. Changing it logs everyone out.
PAYLOAD_SECRET=

# Postgres, same instance as the platform app, in its own "cms" schema.
# Leave EMPTY in local development and Payload uses a SQLite file instead,
# so the admin runs with no database to provision. See payload.config.ts.
DATABASE_URI=

# Cloudflare R2 — same bucket as brand assets, "marketing/" key prefix.
# Leave empty and uploads go to local disk.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# -- Contact form ------------------------------------------------------------
# The form on /contact posts to /api/contact, which emails the message.
#
# Without RESEND_API_KEY the route answers 503 and the form tells the visitor
# it did not send, showing CONTACT_INBOX as a mailto link instead. It never
# reports success for a message it could not deliver, so an unset key here is
# visible rather than silent -- but nothing reaches the inbox until it is set.
#
# Two things are needed on the Resend side, and only one of them is this key:
#   1. An API key:            https://resend.com/api-keys
#   2. A verified domain for the FROM address below. Resend will not send from
#      a domain it has not verified, and the test sender it gives you before
#      verification can only deliver to your own Resend account address.
RESEND_API_KEY=

# Who the site sends as. Must be on the domain verified above -- not a Gmail
# address. Defaults to "Markyos website <website@markyos.com>".
CONTACT_FROM=

# Where messages land. Defaults to markyos.web@gmail.com, which is also where
# they go if this is left empty. Point it somewhere else in staging so a test
# message never reaches the real inbox.
CONTACT_INBOX=
