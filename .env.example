# ─────────────────────────────────────────────────────────────────────────────
# markyos.com — marketing site
# Copy to .env.local and fill. CONTENT_SITE_KEY is a secret: never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin of this site. Used for sitemap.xml, robots.txt, hreflang
# and Open Graph absolute URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Platform origin (no trailing slash). Website auth buttons link directly to
# /login or /signup, preserving language and account type. Use the staging
# platform URL in Preview deployments; rebuild after changing this value.
NEXT_PUBLIC_APP_URL=https://app.markyos.com

# Launch phase. Drives which CTA set renders site-wide and whether the
# announcement bar shows the beta copy or the "we're open" copy.
#   beta   → pre-launch: waitlist CTAs, "Arriving February 2027" on MVP features
#   public → post-launch (from Mon 15 Feb 2027): free-plan CTAs
# See lib/launch.ts and copy doc §3 + §6.3.
NEXT_PUBLIC_LAUNCH_PHASE=public

# ── Website content from the Markyos platform (replaces Payload) ─────────────
# The same Django API used by the platform. No secondary CMS fallback.
# Local: http://localhost:8010/api/v1
# Staging: https://api-staging.markyos.com/api/v1
# Production: https://api.markyos.com/api/v1
CONTENT_API_URL=http://localhost:8010/api/v1
# Shared secret, the same value as the platform's CONTENT_SITE_KEY. Signs page
# views sent to the platform and the platform's "rebuild these pages" calls
# to /api/revalidate. Generate with: openssl rand -base64 32
CONTENT_SITE_KEY=

# Extra image hosts for CMS media, comma-separated, when the platform serves
# uploads from cloud storage (USE_CLOUD_STORAGE) instead of its own /media/.
# Leave empty while media lives on api[-staging].markyos.com. Rebuild after.
CONTENT_MEDIA_HOSTS=

# -- Contact form ------------------------------------------------------------
# /contact posts to /api/contact, which hands the message to the platform
# (POST {CONTENT_API_URL}/content/public/contact/, signed with CONTENT_SITE_KEY).
# The platform stores it (CMS -> Messages) and emails it to its own
# CONTACT_INBOX. If the platform can't be reached, the form shows this address
# so the visitor can write directly. Set it to the same inbox as the platform.
CONTACT_INBOX=
