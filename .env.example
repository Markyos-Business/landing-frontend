# ─────────────────────────────────────────────────────────────────────────────
# markyos.com — marketing site
# Copy to .env.local and fill. Nothing here is a secret until Payload lands.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin of this site. Used for sitemap.xml, robots.txt, hreflang
# and Open Graph absolute URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the product lives. Every CTA on the site redirects into
# ${NEXT_PUBLIC_APP_URL}/start?type=studio|company — see next.config.ts.
NEXT_PUBLIC_APP_URL=https://app.markyos.com

# Launch phase. Drives which CTA set renders site-wide and whether the
# announcement bar shows the beta copy or the "we're open" copy.
#   beta   → pre-launch: waitlist CTAs, "Arriving February 2027" on MVP features
#   public → post-launch (from Mon 15 Feb 2027): free-plan CTAs
# See lib/launch.ts and copy doc §3 + §6.3.
NEXT_PUBLIC_LAUNCH_PHASE=beta

# ── Phase 3: Payload CMS ─────────────────────────────────────────────────────
# Same Neon/Supabase Postgres instance as the platform app, separate schema.
# DATABASE_URI=
# PAYLOAD_SECRET=

# Cloudflare R2 — same bucket as brand assets, separate key prefix.
# R2_BUCKET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# ── Payload CMS ──────────────────────────────────────────────────────────────
# Signs admin sessions. Generate with: openssl rand -base64 32
# Required in every environment. Changing it logs everyone out.
PAYLOAD_SECRET=

# Postgres, same instance as the platform app, in its own "cms" schema.
# Leave EMPTY in local development and Payload uses a SQLite file instead,
# so the admin runs with no database to provision. See payload.config.ts.
DATABASE_URI=

# Cloudflare R2 — same bucket as brand assets, "marketing/" key prefix.
# Leave empty and uploads go to local disk.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
