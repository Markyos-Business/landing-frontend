{
  "name": "markyos-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "markyos.com — the bilingual marketing site. Separate deploy from the platform app.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "payload": "payload",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "cms:migrate": "payload migrate",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "check:tokens": "node scripts/sync-tokens.mjs --check",
    "check:locales": "node --experimental-strip-types --no-warnings scripts/check-locale-parity.mjs",
    "check:design": "node scripts/check-design-rules.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "check:articles": "node scripts/check-articles.mjs",
    "check:live": "npm run check:articles && npm run check:bidi && npm run check:nav && npm run check:pages",
    "check": "tsc --noEmit && eslint . --max-warnings=0 && npm run check:tokens && npm run check:design && npm run check:locales",
    "check:bidi": "node scripts/check-bidi.mjs",
    "check:nav": "node scripts/check-nav.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.91.0",
    "@payloadcms/db-sqlite": "^3.91.0",
    "@payloadcms/next": "^3.91.0",
    "@payloadcms/richtext-lexical": "^3.91.0",
    "@payloadcms/storage-s3": "^3.91.0",
    "graphql": "^16.14.2",
    "line-awesome": "^1.3.0",
    "next": "^16.4.2",
    "payload": "^3.91.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
